#.env

# ===============================
# MODE
# ===============================
TRADING_MODE=shadow
# allowed: paper | shadow | live

# ===============================
# DATABASE
# ===============================
DATABASE_URL=postgresql://neondb_owner:npg_UEHgvB0oRu6k@ep-nameless-pond-a890rm8b-pooler.eastus2.azure.neon.tech/neondb?sslmode=require&channel_binding=require

# ===============================
# MARKET
# ===============================
TRADING_TIMEFRAME=15m
LOOKBACK_BARS=300
LOOP_SLEEP_SECONDS=900

TRADING_SYMBOLS=ETH/USDT,DOGE/USDT
EXCLUDED_SYMBOLS=SOL/USDT,BTC/USDT

# ===============================
# CAPITAL & RISK
# ===============================
PAPER_STARTING_BALANCE_USDT=11
ENTRY_COOLDOWN_MINUTES=30
RISK_PER_TRADE=0.002

# ===============================
# PORTFOLIO
# ===============================
MAX_ACTIVE_POSITIONS=2

# ===============================
# MODEL QUALITY GATES
# ===============================
REQUIRE_MODEL_QUALITY=true
MIN_MODEL_VAL_F1=0.10
MIN_MODEL_VAL_PRECISION=0.10
MIN_MODEL_VAL_RECALL=0.10